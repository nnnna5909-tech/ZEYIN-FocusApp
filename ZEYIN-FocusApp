<!DOCTYPE html>
<html lang="kk" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZEYIN — Focus, AI Planner & Rewards</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { purple: '#6366f1', pink: '#a855f7', cyan: '#38bdf8', emerald: '#34d399', amber: '#fbbf24' }
                    }
                }
            }
        }
    </script>
    <style>
        .glass-card {
            background: rgba(11, 19, 41, 0.85);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(56, 189, 248, 0.25);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7);
            transition: all 0.3s ease;
        }
        .glass-card:hover {
            border-color: rgba(56, 189, 248, 0.5);
            box-shadow: 0 0 35px rgba(56, 189, 248, 0.2);
        }
        .glow-totoro { box-shadow: 0 0 40px -5px rgba(56, 189, 248, 0.5); }
        .glow-emerald { box-shadow: 0 0 40px -5px rgba(52, 211, 153, 0.5); }
        .cat-selected {
            border-color: #38bdf8 !important;
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.35), rgba(168, 85, 247, 0.2)) !important;
            box-shadow: 0 0 25px rgba(56, 189, 248, 0.5);
        }
        body {
            background: linear-gradient(to bottom, rgba(11, 19, 41, 0.75), rgba(9, 14, 28, 0.9)), 
                        url('https://images.unsplash.com/photo-1534447677768-be436bb09401?q=80&w=1920&auto=format&fit=crop') no-repeat center center fixed;
            background-size: cover;
            font-family: Inter, system-ui, Arial, sans-serif;
        }
        @keyframes totoroPulse {
            0%, 100% { transform: scale(1); filter: drop-shadow(0 0 10px rgba(56, 189, 248, 0.6)); }
            50% { transform: scale(1.05); filter: drop-shadow(0 0 20px rgba(168, 85, 247, 0.9)); }
        }
        .logo-anim { animation: totoroPulse 3s infinite ease-in-out; }
    </style>
</head>
<body class="text-gray-100 min-h-screen flex flex-col justify-between antialiased selection:bg-cyan-500 selection:text-white">

    <!-- Top Navigation -->
    <header class="border-b border-cyan-500/20 bg-[#0b1329]/90 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-md mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3 font-black text-xl tracking-wider">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-cyan-500 via-indigo-600 to-purple-600 flex items-center justify-center text-white text-lg shadow-xl logo-anim">
                    <i class="fa-solid fa-umbrella"></i>
                </div>
                <div class="flex flex-col">
                    <span class="bg-gradient-to-r from-white via-cyan-200 to-sky-400 bg-clip-text text-transparent leading-tight tracking-widest text-lg font-black">ZEYIN</span>
                    <span id="navSubtitle" class="text-[9px] text-cyan-300 uppercase tracking-widest font-semibold">Totoro Focus</span>
                </div>
            </div>
            
            <div class="flex items-center gap-2">
                <!-- LANGUAGE SWITCHER -->
                <select id="langSelect" onchange="changeLanguage(this.value)" class="bg-[#111c38] border border-cyan-500/30 text-cyan-300 text-[10px] font-bold rounded-lg px-2 py-1.5 focus:outline-none cursor-pointer">
                    <option value="kk">KZ</option>
                    <option value="ru">RU</option>
                    <option value="en">EN</option>
                </select>

                <div id="userBadge" class="hidden text-xs bg-[#111c38] border border-cyan-500/30 px-3 py-1.5 rounded-full flex items-center gap-1.5 cursor-pointer hover:border-cyan-400 transition shadow-md" onclick="switchTab('profile')">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                    <span id="navUserName" class="font-medium text-gray-200 text-[11px]">User</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-md mx-auto w-full px-4 py-6 flex-grow flex flex-col justify-center relative z-10">

        <!-- STEP 1: Registration / Login & Socials -->
        <section id="registerSection" class="glass-card rounded-3xl p-6 relative overflow-hidden space-y-4">
            <div class="text-center mb-1">
                <div class="w-16 h-16 bg-gradient-to-tr from-cyan-500/25 to-purple-500/25 border border-cyan-500/40 text-cyan-300 rounded-3xl flex items-center justify-center mx-auto mb-3 text-3xl shadow-2xl logo-anim">
                    <i class="fa-solid fa-cloud-moon"></i>
                </div>
                <h1 id="regTitle" class="text-2xl font-black text-white tracking-wide">Зейініңді Шыңда!</h1>
                <p id="regSubtitle" class="text-cyan-300 text-xs mt-1">Премиум фокус жүйесі және AI жоспарлаушы</p>
            </div>

            <div class="grid grid-cols-2 gap-2 text-center">
                <div class="bg-[#0b1329]/90 border border-cyan-500/30 p-3 rounded-2xl">
                    <div class="text-sm font-black text-cyan-400">6 Brands</div>
                    <div id="lblCat" class="text-[9px] text-gray-400 uppercase mt-0.5">Категория</div>
                </div>
                <div class="bg-[#0b1329]/90 border border-cyan-500/30 p-3 rounded-2xl">
                    <div class="text-sm font-black text-purple-300">Smart AI</div>
                    <div id="lblPlan" class="text-[9px] text-gray-400 uppercase mt-0.5">Жоспарлау</div>
                </div>
            </div>

            <form id="regForm" class="space-y-3">
                <div>
                    <label id="labelName" class="block text-xs font-semibold uppercase tracking-wider text-cyan-300 mb-1">Ник аты *</label>
                    <input type="text" id="regName" required placeholder="Арман Әлиев" 
                        class="w-full bg-[#0b1329] border border-cyan-500/30 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-400 transition text-xs shadow-inner">
                </div>
                <div>
                    <label id="labelEmail" class="block text-xs font-semibold uppercase tracking-wider text-cyan-300 mb-1">Email *</label>
                    <input type="email" id="regContact" required placeholder="arman@example.com" 
                        class="w-full bg-[#0b1329] border border-cyan-500/30 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-400 transition text-xs shadow-inner">
                </div>
                <button type="submit" id="btnEnter"
                    class="w-full bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 hover:opacity-95 text-white font-bold py-3.5 rounded-xl shadow-lg glow-totoro active:scale-[0.98] transition text-xs">
                    Жүйеге кіру <i class="fa-solid fa-arrow-right ml-2"></i>
                </button>
            </form>

            <div class="flex items-center my-2 text-gray-500 text-xs">
                <div class="flex-grow border-t border-cyan-500/20"></div>
                <span id="lblOr" class="px-2 uppercase text-[10px]">немесе әлеуметтік желі арқылы</span>
                <div class="flex-grow border-t border-cyan-500/20"></div>
            </div>

            <div class="grid grid-cols-3 gap-2">
                <button onclick="socialLogin('Google')" class="bg-[#111c38] hover:bg-[#162447] border border-cyan-500/30 py-2.5 rounded-xl text-xs font-bold text-white flex items-center justify-center gap-1.5 transition shadow">
                    <i class="fa-brands fa-google text-red-400"></i> Google
                </button>
                <button onclick="socialLogin('VK')" class="bg-[#111c38] hover:bg-[#162447] border border-cyan-500/30 py-2.5 rounded-xl text-xs font-bold text-white flex items-center justify-center gap-1.5 transition shadow">
                    <i class="fa-brands fa-vk text-blue-400"></i> VK
                </button>
                <button onclick="socialLogin('GitHub')" class="bg-[#111c38] hover:bg-[#162447] border border-cyan-500/30 py-2.5 rounded-xl text-xs font-bold text-white flex items-center justify-center gap-1.5 transition shadow">
                    <i class="fa-brands fa-github text-purple-400"></i> GitHub
                </button>
            </div>
        </section>

        <!-- DASHBOARD CONTAINER -->
        <div id="dashboardContainer" class="hidden space-y-4">

            <!-- TAB 1: MAIN HOME / TIMER SETUP & 6 BRAND CATEGORIES -->
            <div id="tabMain" class="tab-pane space-y-4">
                <div class="glass-card rounded-3xl p-4 bg-gradient-to-r from-cyan-950/40 via-indigo-950/30 to-purple-950/30 border border-cyan-500/30 text-center relative overflow-hidden">
                    <div id="lblMotTitle" class="text-[10px] uppercase font-bold text-cyan-300 tracking-wider mb-1"><i class="fa-solid fa-bolt mr-1"></i> Жалпы мотивация</div>
                    <p id="dailyMotivationText" class="text-xs text-white font-medium italic">«Әрбір үлкен жетістік кішкентай ғана қадамнан басталады!»</p>
                </div>

                <div class="glass-card rounded-3xl p-4 text-center">
                    <h2 id="lblFocusTitle" class="text-sm font-bold text-white mb-0.5">Фокус сессиясы</h2>
                    <p id="lblFocusDesc" class="text-gray-400 text-[11px]">Бренд категориясын таңдап, фокусты бастаңыз!</p>
                </div>

                <!-- 6 BRAND CATEGORIES -->
                <div>
                    <label id="lblSelectBrand" class="block text-[11px] font-extrabold uppercase tracking-wider text-cyan-300 mb-2">1. Бренд Категориясын таңдаңыз:</label>
                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="toggleCategory('food')" id="cat-food" class="cat-btn cat-selected glass-card p-3 rounded-2xl text-left border border-cyan-500/20 transition">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-xl bg-orange-500/20 text-orange-400 flex items-center justify-center text-xs shrink-0"><i class="fa-solid fa-burger"></i></div>
                                <div><div class="text-[11px] font-bold text-white cat-food-title">Тамақ</div><div class="text-[9px] text-gray-400">CoffeeBoom</div></div>
                            </div>
                        </button>
                        <button onclick="toggleCategory('fashion')" id="cat-fashion" class="cat-btn glass-card p-3 rounded-2xl text-left border border-cyan-500/20 transition">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center text-xs shrink-0"><i class="fa-solid fa-shirt"></i></div>
                                <div><div class="text-[11px] font-bold text-white cat-fashion-title">Киім</div><div class="text-[9px] text-gray-400">Zara & Mango</div></div>
                            </div>
                        </button>
                        <button onclick="toggleCategory('education')" id="cat-education" class="cat-btn glass-card p-3 rounded-2xl text-left border border-cyan-500/20 transition">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center text-xs shrink-0"><i class="fa-solid fa-graduation-cap"></i></div>
                                <div><div class="text-[11px] font-bold text-white cat-edu-title">Білім</div><div class="text-[9px] text-gray-400">Coursera</div></div>
                            </div>
                        </button>
                        <button onclick="toggleCategory('books')" id="cat-books" class="cat-btn glass-card p-3 rounded-2xl text-left border border-cyan-500/20 transition">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs shrink-0"><i class="fa-solid fa-book"></i></div>
                                <div><div class="text-[11px] font-bold text-white cat-books-title">Кітаптар</div><div class="text-[9px] text-gray-400">Meloman</div></div>
                            </div>
                        </button>
                        <button onclick="toggleCategory('tech')" id="cat-tech" class="cat-btn glass-card p-3 rounded-2xl text-left border border-cyan-500/20 transition">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-xl bg-cyan-500/20 text-cyan-300 flex items-center justify-center text-xs shrink-0"><i class="fa-solid fa-laptop-code"></i></div>
                                <div><div class="text-[11px] font-bold text-white cat-tech-title">Техника</div><div class="text-[9px] text-gray-400">Technodom</div></div>
                            </div>
                        </button>
                        <button onclick="toggleCategory('sport')" id="cat-sport" class="cat-btn glass-card p-3 rounded-2xl text-left border border-cyan-500/20 transition">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-xl bg-pink-500/20 text-pink-400 flex items-center justify-center text-xs shrink-0"><i class="fa-solid fa-dumbbell"></i></div>
                                <div><div class="text-[11px] font-bold text-white cat-sport-title">Спорт</div><div class="text-[9px] text-gray-400">World Class</div></div>
                            </div>
                        </button>
                    </div>
                </div>

                <div>
                    <label id="lblSelectTime" class="block text-[11px] font-extrabold uppercase tracking-wider text-cyan-400 mb-2">2. Ұзақтығын таңдаңыз (1 мин = 12 ₸):</label>
                    <div class="grid grid-cols-4 gap-1.5">
                        <button onclick="selectDuration(15)" class="glass-card hover:border-cyan-400 rounded-2xl p-2.5 text-center transitionshadow-lg">
                            <div class="text-xs font-black text-white">15 мин</div>
                            <div class="text-[9px] text-emerald-400 font-bold mt-0.5">+180 ₸</div>
                        </button>
                        <button onclick="selectDuration(35)" class="glass-card hover:border-cyan-400 rounded-2xl p-2.5 text-center transition shadow-lg">
                            <div class="text-xs font-black text-white">35 мин</div>
                            <div class="text-[9px] text-emerald-400 font-bold mt-0.5">+420 ₸</div>
                        </button>
                        <button onclick="selectDuration(45)" class="glass-card hover:border-cyan-400 rounded-2xl p-2.5 text-center transition shadow-lg">
                            <div class="text-xs font-black text-white">45 мин</div>
                            <div class="text-[9px] text-emerald-400 font-bold mt-0.5">+540 ₸</div>
                        </button>
                        <button onclick="selectDuration(60)" class="glass-card hover:border-cyan-400 rounded-2xl p-2.5 text-center transition shadow-lg">
                            <div class="text-xs font-black text-white">60 мин</div>
                            <div class="text-[9px] text-emerald-400 font-bold mt-0.5">+720 ₸</div>
                        </button>
                    </div>
                </div>
            </div>

            <!-- TAB 2: ACTIVE TIMER & ARCADE GAMES HUB -->
            <div id="tabTimer" class="tab-pane hidden space-y-4">
                <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-3 flex items-center gap-3 text-amber-300 text-xs shadow-lg">
                    <i class="fa-solid fa-shield-cat text-lg text-amber-400 shrink-0"></i>
                    <span id="antiCheatMsg"><strong>Анти-чит белсенді:</strong> Басқа вкладкаға шықсаңыз сессия бұзылады!</span>
                </div>

                <div class="glass-card rounded-3xl p-5 text-center relative overflow-hidden shadow-2xl glow-totoro border border-cyan-500/30 space-y-2">
                    <div id="lblTimerActive" class="text-xs uppercase tracking-widest text-cyan-300 font-bold">Фокус уақыты жүріп жатыр</div>
                    <div id="timerDisplay" class="text-5xl font-black text-white tracking-tight font-mono my-1">25:00</div>
                    <div class="text-[11px] text-emerald-400 font-semibold" id="activeBrandLabel">Таңдалған бренд: CoffeeBoom</div>
                    <div class="w-full bg-[#0b1329] h-2.5 rounded-full overflow-hidden p-0.5 border border-cyan-500/20">
                        <div id="timerProgress" class="bg-gradient-to-r from-cyan-400 to-indigo-500 h-full w-full rounded-full transition-all duration-1000"></div>
                    </div>
                </div>

                <!-- ARCADE MINI GAMES SECTION -->
                <div class="glass-card rounded-3xl p-4 space-y-3">
                    <div class="flex items-center justify-between">
                        <span id="lblArcadeHub" class="text-xs font-bold uppercase tracking-wider text-cyan-300 flex items-center gap-1.5">
                            <i class="fa-solid fa-gamepad text-amber-400"></i> Аркада Мини-Ойындары (Демалыс)
                        </span>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <button onclick="openArcadeGame('snake')" class="bg-[#0b1329] hover:bg-[#111c38] border border-cyan-500/20 p-3 rounded-2xl text-center text-xs transition shadow group">
                            <i class="fa-solid fa-worm text-emerald-400 text-lg mb-1 group-hover:scale-110 transition"></i>
                            <div id="gameSnakeName" class="font-bold text-[11px] text-white">Ретро Жыланша</div>
                        </button>
                        <button onclick="openArcadeGame('clicker')" class="bg-[#0b1329] hover:bg-[#111c38] border border-cyan-500/20 p-3 rounded-2xl text-center text-xs transition shadow group">
                            <i class="fa-solid fa-bolt text-amber-400 text-lg mb-1 group-hover:scale-110 transition"></i>
                            <div id="gameClickerName" class="font-bold text-[11px] text-white">Неон Кликер</div>
                        </button>
                    </div>
                </div>
            </div>

            <!-- TAB 3: AI PLANNER & GOALS -->
            <div id="tabGoals" class="tab-pane hidden space-y-4">
                <div class="glass-card rounded-3xl p-5 space-y-3 bg-gradient-to-r from-cyan-950/40 via-indigo-950/30 to-purple-950/30 border border-cyan-500/40">
                    <div class="flex items-center justify-between">
                        <h2 id="aiPlannerTitle" class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-wand-magic-sparkles text-amber-400"></i> ZEYIN AI Жоспарлаушысы
                        </h2>
                        <span class="text-[9px] bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 px-2 py-0.5 rounded-full font-semibold">Smart AI</span>
                    </div>
                    <p id="aiPlannerSubtitle" class="text-[11px] text-gray-300">Немен айналысқыңыз келеді? (Мысалы: «Экзаменге дайындық»)</p>
                    <div class="flex gap-2">
                        <input type="text" id="aiTopicInput" placeholder="Тақырыпты жазыңыз..." 
                            class="w-full bg-[#0b1329] border border-cyan-500/30 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-cyan-400 shadow-inner">
                        <button onclick="generateAIPlan()" id="btnGenerateAI" class="bg-gradient-to-r from-cyan-500 to-indigo-600 hover:opacity-90 text-white font-bold px-4 py-2.5 rounded-xl text-xs transition shadow shrink-0">
                            Жоспар құру ✦
                        </button>
                    </div>
                </div>

                <div class="glass-card rounded-3xl p-5 space-y-4 shadow-xl">
                    <div class="flex items-center justify-between">
                        <h2 id="goalsHeaderTitle" class="text-base font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-bullseye text-cyan-300"></i> Менің мақсаттарым
                        </h2>
                        <span id="goalStatsBadge" class="text-xs text-cyan-300 bg-cyan-500/20 px-2.5 py-1 rounded-full border border-cyan-500/30">0/0 орындалды</span>
                    </div>
                    <div class="flex gap-2">
                        <input type="text" id="newGoalInput" placeholder="Мақсат жазу..." 
                            class="w-full bg-[#0b1329] border border-cyan-500/30 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-cyan-400 shadow-inner">
                        <button onclick="addGoal()" class="bg-cyan-500 hover:bg-cyan-400 text-black font-bold px-4 py-2.5 rounded-xl text-xs transition shadow">
                            <i class="fa-solid fa-plus"></i>
                        </button>
                    </div>
                    <div id="goalsListContainer" class="space-y-2 max-h-48 overflow-y-auto pr-1"></div>
                </div>
            </div>

            <!-- TAB 4: PROFILE & EARNED BONUSES ONLY -->
            <div id="tabProfile" class="tab-pane hidden space-y-4">
                <div class="glass-card rounded-3xl overflow-hidden shadow-2xl relative">
                    <div id="profileBannerView" class="h-28 bg-gradient-to-r from-cyan-600 via-indigo-600 to-purple-600 relative bg-cover bg-center"></div>
                    <div class="px-6 pb-6 text-center relative -mt-12 space-y-3">
                        <div class="w-24 h-24 bg-gray-900 border-4 border-[#0b1329] rounded-2xl overflow-hidden mx-auto shadow-2xl flex items-center justify-center font-black text-4xl text-white bg-cover bg-center" id="profileAvatarView">
                            A
                        </div>
                        <div>
                            <h2 class="text-xl font-black text-white" id="profileNameView">Арман Әлиев</h2>
                            <p class="text-cyan-300 text-xs" id="profileEmailView">arman@example.com</p>
                        </div>
                    </div>
                </div>

                <!-- EARNED BONUSES SUMMARY CARD -->
                <div class="glass-card rounded-3xl p-4 bg-gradient-to-r from-indigo-950/60 via-purple-950/50 to-cyan-950/60 border border-cyan-500/40 text-center space-y-1">
                    <div id="rewardsSummaryTitle" class="text-[10px] font-black text-cyan-300 uppercase tracking-wider">
                        <i class="fa-solid fa-coins text-amber-400 mr-1"></i> Жиналған бонустар балансы
                    </div>
                    <div class="text-3xl font-black text-emerald-400 font-mono" id="totalEarnedBonuses">250 ₸</div>
                    <div class="text-[10px] text-gray-400">Тек сәтті аяқталған фокус сессиялары үшін беріледі (1 мин = 12 ₸)</div>
                </div>

                <div class="glass-card rounded-3xl p-5 space-y-3 shadow-xl">
                    <h3 id="profileSettingsTitle" class="text-sm font-bold text-white mb-2"><i class="fa-solid fa-pen-to-square text-cyan-400 mr-1.5"></i> Профильді баптау</h3>
                    <div>
                        <label id="lblEditName" class="block text-[10px] text-cyan-300 uppercase font-bold mb-1">Ник аты</label>
                        <input type="text" id="editName" class="w-full bg-[#0b1329] border border-cyan-500/30 rounded-xl px-3.5 py-2 text-xs text-white shadow-inner">
                    </div>
                    <div>
                        <label id="lblEditEmail" class="block text-[10px] text-cyan-300 uppercase font-bold mb-1">Email</label>
                        <input type="email" id="editEmail" class="w-full bg-[#0b1329] border border-cyan-500/30 rounded-xl px-3.5 py-2 text-xs text-white shadow-inner">
                    </div>
                    <div>
                        <label id="lblEditAvatar" class="block text-[10px] text-cyan-300 uppercase font-bold mb-1">Аватар суретін жүктеу</label>
