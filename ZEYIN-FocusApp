            document.querySelectorAll('.cat-tech-title')[0].innerText = t.catTech;
            document.querySelectorAll('.cat-sport-title')[0].innerText = t.catSport;

            document.getElementById('antiCheatMsg').innerHTML = t.antiCheatMsg;
            document.getElementById('lblTimerActive').innerText = t.lblTimerActive;
            document.getElementById('lblArcadeHub').innerHTML = `<i class="fa-solid fa-gamepad text-amber-400"></i> ${t.lblArcadeHub}`;
            document.getElementById('gameSnakeName').innerText = t.gameSnakeName;
            document.getElementById('gameClickerName').innerText = t.gameClickerName;

            document.getElementById('aiPlannerTitle').innerHTML = `<i class="fa-solid fa-wand-magic-sparkles text-amber-400"></i> ${t.aiPlannerTitle}`;
            document.getElementById('aiPlannerSubtitle').innerText = t.aiPlannerSubtitle;
            document.getElementById('aiTopicInput').placeholder = t.aiInputPlaceholder;
            document.getElementById('btnGenerateAI').innerText = t.btnGenerateAI;

            document.getElementById('goalsHeaderTitle').innerHTML = `<i class="fa-solid fa-bullseye text-cyan-300"></i> ${t.goalsHeaderTitle}`;
            document.getElementById('newGoalInput').placeholder = t.goalInputPlaceholder;

            document.getElementById('rewardsSummaryTitle').innerHTML = `<i class="fa-solid fa-coins text-amber-400 mr-1"></i> ${t.rewardsSummaryTitle}`;
            document.getElementById('profileSettingsTitle').innerHTML = `<i class="fa-solid fa-pen-to-square text-cyan-400 mr-1.5"></i> ${t.profileSettingsTitle}`;
            document.getElementById('lblEditName').innerText = t.lblEditName;
            document.getElementById('lblEditEmail').innerText = t.lblEditEmail;
            document.getElementById('lblEditAvatar').innerText = t.lblEditAvatar;
            document.getElementById('lblEditBanner').innerText = t.lblEditBanner;
            document.getElementById('btnSaveProfile').innerText = t.btnSaveProfile;
            document.getElementById('btnLogout').innerText = t.btnLogout;

            document.getElementById('successTitle').innerText = t.successTitle;
            document.getElementById('successDesc').innerText = t.successDesc;
            document.getElementById('btnReturnMain').innerText = t.btnReturnMain;

            document.getElementById('cheatTitle').innerText = t.cheatTitle;
            document.getElementById('cheatDesc').innerText = t.cheatDesc;
            document.getElementById('btnRestart').innerText = t.btnRestart;
            document.getElementById('btnCloseArcade').innerText = t.btnCloseArcade;

            document.getElementById('navHomeText').innerText = t.navHomeText;
            document.getElementById('navTimerText').innerText = t.navTimerText;
            document.getElementById('navGoalsText').innerText = t.navGoalsText;
            document.getElementById('navProfileText').innerText = t.navProfileText;

            const motList = t.motivations;
            document.getElementById('dailyMotivationText').innerText = motList[Math.floor(Math.random() * motList.length)];
        }

        let currentUser = JSON.parse(localStorage.getItem('zeyin_user')) || null;
        let stats = JSON.parse(localStorage.getItem('zeyin_stats')) || { sessions: 0, minutes: 0 };
        let userBonus = Number(localStorage.getItem('zeyin_bonus')) || 250;
        let goals = JSON.parse(localStorage.getItem('zeyin_goals')) || [{ text: "Математика  оқу", completed: false }];
        let selectedCategories = ['food'];
        let selectedMinutes = 25;
        let earnedCurrentSession = 300;
        let quizAnswers = {};

        const brandNames = {
            food: 'CoffeeBoom (Тамақ)',
            fashion: 'Zara & Mango (Киім)',
            education: 'Coursera (Білім)',
            books: 'Meloman (Кітаптар)',
            tech: 'Technodom (Техника)',
            sport: 'World Class (Спорт)'
        };

        window.onload = function() {
            if(currentUser) loginSuccessUI();
            renderGoals();
            updateBonusUI();
            changeLanguage('kk');
        }

        function updateBonusUI() {
            document.getElementById('totalEarnedBonuses').innerText = `${userBonus.toLocaleString()} ₸`;
        }

        document.getElementById('regForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const name = document.getElementById('regName').value.trim();
            const contact = document.getElementById('regContact').value.trim();
            if(!name || !contact) return;
            currentUser = { name, email: contact, avatar: '', banner: '' };
            localStorage.setItem('zeyin_user', JSON.stringify(currentUser));
            loginSuccessUI();
        });

        function socialLogin(provider) {
            const inputName = prompt(`${provider} арқылы кіру үшін аты-жөніңізді енгізіңіз:`);
            if(!inputName || inputName.trim() === "") return;
            currentUser = { name: inputName.trim(), email: `${provider.toLowerCase()}_user@auth.com`, avatar: '', banner: '' };
            localStorage.setItem('zeyin_user', JSON.stringify(currentUser));
            loginSuccessUI();
        }

        function loginSuccessUI() {
            document.getElementById('registerSection').classList.add('hidden');
            document.getElementById('dashboardContainer').classList.remove('hidden');
            document.getElementById('bottomNav').classList.remove('hidden');
            document.getElementById('navTimerBtn').classList.remove('hidden');
            
            document.getElementById('navUserName').innerText = currentUser.name;
            document.getElementById('profileNameView').innerText = currentUser.name;
            document.getElementById('profileEmailView').innerText = currentUser.email;
            
            document.getElementById('editName').value = currentUser.name;
            document.getElementById('editEmail').value = currentUser.email;

            updateAvatarAndBanner();
            updateBonusUI();
        }

        function updateAvatarAndBanner() {
            const avatarEl = document.getElementById('profileAvatarView');
            if(currentUser.avatar) {
                avatarEl.style.backgroundImage = `url(${currentUser.avatar})`;
                avatarEl.innerText = '';
            } else {
                avatarEl.style.backgroundImage = '';
                avatarEl.innerText = currentUser.name[0].toUpperCase();
            }

            const bannerEl = document.getElementById('profileBannerView');
            if(currentUser.banner) {
                bannerEl.style.backgroundImage = `url(${currentUser.banner})`;
            } else {
                bannerEl.style.backgroundImage = '';
            }
        }

        function saveProfile() {
            currentUser.name = document.getElementById('editName').value.trim();
            currentUser.email = document.getElementById('editEmail').value.trim();

            const avatarFile = document.getElementById('editAvatarFile').files[0];
            const bannerFile = document.getElementById('editBannerFile').files[0];

            let pendingSaves = 0;

            if(avatarFile) {
                pendingSaves++;
                const reader = new FileReader();
                reader.onload = function(e) {
                    currentUser.avatar = e.target.result;
                    checkDone();
                };
                reader.readAsDataURL(avatarFile);
            }

            if(bannerFile) {
                pendingSaves++;
                const reader = new FileReader();
                reader.onload = function(e) {
                    currentUser.banner = e.target.result;
                    checkDone();
                };
                reader.readAsDataURL(bannerFile);
            }

            if(pendingSaves === 0) finalizeSave();

            function checkDone() {
                pendingSaves--;
                if(pendingSaves === 0) finalizeSave();
            }

            function finalizeSave() {
                localStorage.setItem('zeyin_user', JSON.stringify(currentUser));
                loginSuccessUI();
                alert('Профиль мен суреттер сәтті сақталды!');
            }
        }

        function logoutUser() {
            localStorage.removeItem('zeyin_user');
            location.reload();
        }

        function switchTab(tabName) {
            ['tabMain', 'tabTimer', 'tabGoals', 'tabProfile', 'rewardSection'].forEach(id => {
                const el = document.getElementById(id);
                if(el) el.classList.add('hidden');
            });
            if(tabName === 'main') document.getElementById('tabMain').classList.remove('hidden');
            else if(tabName === 'timer') document.getElementById('tabTimer').classList.remove('hidden');
            else if(tabName === 'goals') document.getElementById('tabGoals').classList.remove('hidden');
            else if(tabName === 'profile') document.getElementById('tabProfile').classList.remove('hidden');
        }

        function toggleCategory(cat) {
            const idx = selectedCategories.indexOf(cat);
            if (idx > -1) {
                if (selectedCategories.length > 1) selectedCategories.splice(idx, 1);
            } else {
                selectedCategories.push(cat);
            }
            ['food', 'fashion', 'education', 'books', 'tech', 'sport'].forEach(c => {
                const btn = document.getElementById(`cat-${c}`);
                if(btn) {
                    if (selectedCategories.includes(c)) btn.classList.add('cat-selected');
                    else btn.classList.remove('cat-selected');
                }
            });
        }

        let totalDurationSeconds = 1500;
        let endTime = 0;
        let timerInterval = null;
        let isSessionActive = false;

        function selectDuration(mins) {
            selectedMinutes = mins;
            totalDurationSeconds = mins * 60;
            endTime = Date.now() + (totalDurationSeconds * 1000);
            
            // 1 минут = 12 теңге формуласы
            earnedCurrentSession = mins * 12;

            const activeCategory = selectedCategories[0] || 'food';
            document.getElementById('activeBrandLabel').innerText = `Бренд: ${brandNames[activeCategory]}`;

            switchTab('timer');
            startTimer();
        }

        function startTimer() {
            isSessionActive = true;
            if (timerInterval) clearInterval(timerInterval);

            timerInterval = setInterval(() => {
                const now = Date.now();
                const secondsLeft = Math.max(0, Math.floor((endTime - now) / 1000));
                updateTimerDisplay(secondsLeft);

                if (secondsLeft <= 0) {
                    clearInterval(timerInterval);
                    isSessionActive = false;
                    finishSession();
                }
            }, 500);
        }

        function updateTimerDisplay(secondsLeft) {
            const mins = Math.floor(secondsLeft / 60);
            const secs = secondsLeft % 60;
            const disp = document.getElementById('timerDisplay');
            if(disp) disp.innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            
            const prog = document.getElementById('timerProgress');
            if(prog) prog.style.width = `${(secondsLeft / totalDurationSeconds) * 100}%`;
        }

        // --- ARCADE MINI GAMES (NO MONEY) ---
        function openArcadeGame(type) {
            document.getElementById('arcadeGameModal').classList.remove('hidden');
            const title = document.getElementById('arcadeTitle');
            const body = document.getElementById('arcadeBody');

            if(type === 'snake') {
                title.innerText = "👾 Ретро Жыланша (Демалыс ойыны)";
                body.innerHTML = `
                    <p class="mb-2 text-cyan-400 font-bold text-[11px]">Жыланша тек көңіл көтеру үшін ойналады!</p>
                    <div class="bg-[#0b1329] border border-cyan-500/30 p-6 rounded-2xl text-center font-mono text-xs my-2 space-y-2">
                        <div class="text-gray-400">Жемістер жиналды: <span id="snakeScore" class="text-emerald-400 font-bold">0</span></div>
                        <button onclick="feedSnake()" class="w-full bg-cyan-500 hover:bg-cyan-400 text-black font-black py-2 rounded-xl transition active:scale-95 shadow">🍎 Жемісті жеу (+1 ұпай)</button>
                    </div>
                `;
            } else if(type === 'clicker') {
                title.innerText = "⚡ Неон Кликер (Демалыс ойыны)";
                body.innerHTML = `
                    <div class="space-y-3">
                        <div class="flex justify-between text-xs text-gray-400 font-bold px-1">
                            <span>Уақыт: <strong id="arcadeTimer" class="text-amber-400">10</strong>с</span>
                            <span>Ұпай: <strong id="arcadeScore" class="text-cyan-400 font-mono text-base">0</strong></span>
                        </div>
                        <button id="arcadeClickBtn" onclick="clickArcade()" disabled class="w-full bg-[#111c38] border border-cyan-500/30 text-gray-400 py-6 rounded-2xl font-black text-sm transition active:scale-95 shadow-lg">
                            Бастау үшін төмендегі батырманы бас!
                        </button>
                        <button id="arcadeStartBtn" onclick="startArcadeClicker()" class="w-full bg-gradient-to-r from-cyan-500 to-indigo-600 text-white font-bold py-2.5 rounded-xl text-xs transition shadow">
                            Ойынды бастау 🚀
                        </button>
                    </div>
                `;
            }
        }

        let snakeScoreVal = 0;
        function feedSnake() {
            snakeScoreVal++;
            document.getElementById('snakeScore').innerText = snakeScoreVal;
        }

        let arcadeActive = false;
        let arcadeScoreVal = 0;
        let arcadeTimeLeft = 10;
        let arcadeInterval = null;

        function startArcadeClicker() {
            arcadeScoreVal = 0;
            arcadeTimeLeft = 10;
            arcadeActive = true;
            document.getElementById('arcadeScore').innerText = '0';
            document.getElementById('arcadeTimer').innerText = '10';
            
            const btn = document.getElementById('arcadeClickBtn');
            btn.disabled = false;
            btn.className = "w-full bg-gradient-to-tr from-cyan-400 via-indigo-500 to-purple-500 text-black font-black py-6 rounded-2xl text-base transition active:scale-90 shadow-xl cursor-pointer";
            btn.innerText = "ТЕЗ-ТЕЗ БАС!";
            
            document.getElementById('arcadeStartBtn').classList.add('hidden');

            if(arcadeInterval) clearInterval(arcadeInterval);

            arcadeInterval = setInterval(() => {
                arcadeTimeLeft--;
                document.getElementById('arcadeTimer').innerText = arcadeTimeLeft;
                if(arcadeTimeLeft <= 0) {
                    clearInterval(arcadeInterval);
                    arcadeActive = false;
                    btn.disabled = true;
                    btn.className = "w-full bg-[#111c38] border border-cyan-500/30 text-gray-400 py-6 rounded-2xl font-bold text-xs";
                    btn.innerText = `Уақыт бітті! Жиналған ұпай: ${arcadeScoreVal}`;
                    document.getElementById('arcadeStartBtn').classList.remove('hidden');
                    document.getElementById('arcadeStartBtn').innerText = "Қайтадан ойнау";
                }
            }, 1000);
        }

        function clickArcade() {
            if(!arcadeActive) return;
            arcadeScoreVal++;
            document.getElementById('arcadeScore').innerText = arcadeScoreVal;
        }

        function closeArcadeGame() {
            if(arcadeInterval) clearInterval(arcadeInterval);
            document.getElementById('arcadeGameModal').classList.add('hidden');
        }

        // --- ANTI-CHEAT LISTENERS ---
        document.addEventListener('visibilitychange', () => {
            if (isSessionActive && document.hidden) {
                triggerCheatDetection();
            }
        });

        window.addEventListener('blur', () => {
            if (isSessionActive) {
                triggerCheatDetection();
            }
        });

        function triggerCheatDetection() {
            if(!isSessionActive) return;
            clearInterval(timerInterval);
            isSessionActive = false;
            document.getElementById('cheatModal').classList.remove('hidden');
        }

        function closeCheatModal() {
            document.getElementById('cheatModal').classList.add('hidden');
            switchTab('main');
        }

        // --- AI PLANNER ---
        function generateAIPlan() {
            const topic = document.getElementById('aiTopicInput').value.trim();
            if(!topic) {
                alert('Жоспар құру үшін тақырыпты енгізіңіз!');
                return;
            }

            const aiSteps = [
                `[AI] ${topic}: Теориялық қадам (25 мин)`,
                `[AI] ${topic}: Практикалық қадам (25 мин)`,
                `[AI] ${topic}: Қорытындылау (15 мин)`
            ];

            aiSteps.forEach(step => {
                goals.push({ text: step, completed: false });
            });

            localStorage.setItem('zeyin_goals', JSON.stringify(goals));
            document.getElementById('aiTopicInput').value = '';
            renderGoals();
            alert('ZEYIN AI тақырып бойынша жеке фокус-жоспар құрды!');
        }

        function addGoal() {
            const input = document.getElementById('newGoalInput');
            const val = input.value.trim();
            if(!val) return;
            goals.push({ text: val, completed: false });
            localStorage.setItem('zeyin_goals', JSON.stringify(goals));
            input.value = '';
            renderGoals();
        }

        function toggleGoal(i) {
            goals[i].completed = !goals[i].completed;
            localStorage.setItem('zeyin_goals', JSON.stringify(goals));
            renderGoals();
        }

        function deleteGoal(i) {
            goals.splice(i, 1);
            localStorage.setItem('zeyin_goals', JSON.stringify(goals));
            renderGoals();
        }

        function renderGoals() {
            const container = document.getElementById('goalsListContainer');
            if(!container) return;
            container.innerHTML = goals.map((g, idx) => `
                <div class="flex items-center justify-between bg-[#0b1329] border border-cyan-500/30 p-2.5 rounded-xl text-xs shadow-inner">
                    <div class="flex items-center gap-2.5 overflow-hidden">
                        <input type="checkbox" ${g.completed ? 'checked' : ''} onchange="toggleGoal(${idx})" class="accent-cyan-400 w-4 h-4 rounded cursor-pointer shrink-0">
                        <span class="${g.completed ? 'line-through text-gray-500' : 'text-gray-200'} truncate">${g.text}</span>
                    </div>
                    <button onclick="deleteGoal(${idx})" class="text-red-400 hover:text-red-300 px-2 py-1 transition shrink-0" title="Жою">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            `).join('');
            document.getElementById('goalStatsBadge').innerText = `${goals.filter(x=>x.completed).length}/${goals.length} орындалды`;
        }

        // --- 10 QUIZZES RENDER ---
        function renderQuizzes() {
            quizAnswers = {};
            const container = document.getElementById('quizContainer');
            container.innerHTML = adQuizzes.map((quiz, qIdx) => `
                <div class="bg-[#0b1329] border border-cyan-500/20 p-3 rounded-xl space-y-2">
                    <div class="text-[11px] font-bold text-white">${quiz.q}</div>
                    <div class="grid grid-cols-3 gap-1.5">
                        ${quiz.opts.map((opt, oIdx) => `
                            <button onclick="answerQuiz(${qIdx}, ${oIdx})" id="q${qIdx}o${oIdx}" class="bg-[#111c38] hover:bg-[#162447] border border-cyan-500/20 py-1.5 px-2 rounded-lg text-[10px] text-gray-300 transition text-center truncate">
                                ${opt}
                            </button>
                        `).join('')}
                    </div>
                </div>
            `).join('');
            updateQuizScore();
        }

        function answerQuiz(qIdx, oIdx) {
            quizAnswers[qIdx] = oIdx;
            const quiz = adQuizzes[qIdx];
            quiz.opts.forEach((_, optIdx) => {
                const btn = document.getElementById(`q${qIdx}o${optIdx}`);
                btn.className = "bg-[#111c38] hover:bg-[#162447] border border-cyan-500/20 py-1.5 px-2 rounded-lg text-[10px] text-gray-300 transition text-center truncate";
                if(optIdx === oIdx) {
                    if(oIdx === quiz.correct) {
                        btn.classList.add('bg-emerald-500/20', 'border-emerald-400', 'text-emerald-300', 'font-bold');
                    } else {
                        btn.classList.add('bg-red-500/20', 'border-red-400', 'text-red-300', 'font-bold');
                    }
                }
            });
            updateQuizScore();
        }

        function updateQuizScore() {
            let correctCount = 0;
            Object.keys(quizAnswers).forEach(qIdx => {
                if(quizAnswers[qIdx] === adQuizzes[qIdx].correct) {
                    correctCount++;
                }
            });
            document.getElementById('quizScoreBadge').innerText = `Ұпай: ${correctCount}/10`;
        }

        function finishSession() {
            stats.sessions += 1;
            stats.minutes += selectedMinutes;
            localStorage.setItem('zeyin_stats', JSON.stringify(stats));
            
            userBonus += earnedCurrentSession;
            localStorage.setItem('zeyin_bonus', userBonus);
            updateBonusUI();

            document.getElementById('earnedBonusPopup').innerText = `+${earnedCurrentSession} ₸ бонус қосылды!`;
            document.getElementById('tabTimer').classList.add('hidden');
            document.getElementById('rewardSection').classList.remove('hidden');
            renderQuizzes();
        }

        function returnToMain() {
            document.getElementById('rewardSection').classList.add('hidden');
            switchTab('main');
        }
    </script>
</body>
</html>
   
